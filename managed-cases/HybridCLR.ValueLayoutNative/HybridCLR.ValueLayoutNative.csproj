<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>netstandard2.1</TargetFramework><Nullable>disable</Nullable></PropertyGroup>
  <ItemGroup>
    <Reference Include="HybridCLR.ValueLayoutModel">
      <HintPath>$(DheValueLayoutBaseRoot)/HybridCLR.ValueLayoutModel.dll</HintPath>
      <Private>false</Private>
    </Reference>
  </ItemGroup>
  <Target Name="RequireImmutableBase" BeforeTargets="ResolveReferences">
    <Error Condition="'$(DheValueLayoutBaseRoot)' == '' Or !Exists('$(DheValueLayoutBaseRoot)/HybridCLR.ValueLayoutModel.dll')"
           Text="Set DheValueLayoutBaseRoot to the immutable model Base DLL directory." />
  </Target>
</Project>
