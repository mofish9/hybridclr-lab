<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);8632;0649</NoWarn>
  </PropertyGroup>
  <Target Name="RequirePackage" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DhePackageRoot)' == ''" Text="Pass -p:DhePackageRoot with the package source being tested." />
  </Target>
  <ItemGroup>
    <Compile Include="$(DhePackageRoot)/Runtime/DheExecutionPlan.cs" Link="Package/DheExecutionPlan.cs" />
    <Compile Include="$(DhePackageRoot)/Runtime/DheRuntime.cs" Link="Package/DheRuntime.cs" />
    <Compile Include="$(DhePackageRoot)/Runtime/LoadImageErrorCode.cs" Link="Package/LoadImageErrorCode.cs" />
    <Compile Include="$(DhePackageRoot)/Runtime/HomologousImageMode.cs" Link="Package/HomologousImageMode.cs" />
  </ItemGroup>
</Project>
