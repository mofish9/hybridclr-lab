<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);8632;0649</NoWarn>
  </PropertyGroup>
  <Target Name="RequirePackage" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DhePackageRoot)' == ''" Text="Pass -p:DhePackageRoot with the package source being tested." />
  </Target>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DhePackageRoot</_Parameter1>
      <_Parameter2>$(DhePackageRoot)</_Parameter2>
    </AssemblyAttribute>
    <Compile Include="$(DhePackageRoot)/Runtime/DheExecutionPlan.cs" Link="Package/DheExecutionPlan.cs" />
    <Compile Include="$(DhePackageRoot)/Runtime/DheRuntime.cs" Link="Package/DheRuntime.cs" />
    <Compile Include="$(DhePackageRoot)/Runtime/DheRuntime.Loading.cs" Link="Package/DheRuntime.Loading.cs" Condition="Exists('$(DhePackageRoot)/Runtime/DheRuntime.Loading.cs')" />
    <Compile Include="$(DhePackageRoot)/Runtime/LoadImageErrorCode.cs" Link="Package/LoadImageErrorCode.cs" />
    <Compile Include="$(DhePackageRoot)/Runtime/HomologousImageMode.cs" Link="Package/HomologousImageMode.cs" />
    <Compile Include="../../MetaVersion.cs" Link="Tool/MetaVersion.cs" />
    <Compile Include="../../DheValueLayoutImpact.cs" Link="Tool/DheValueLayoutImpact.cs" />
    <Compile Include="../../ResourceExecutionPlan.cs" Link="Tool/ResourceExecutionPlan.cs" />
    <Compile Include="../../ResourceUpdateCompatibility.cs" Link="Tool/ResourceUpdateCompatibility.cs" />
    <Reference Include="dnlib"><HintPath>../../dnlib.dll</HintPath></Reference>
  </ItemGroup>
</Project>
