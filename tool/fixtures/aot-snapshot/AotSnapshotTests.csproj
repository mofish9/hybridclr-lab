<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
  </PropertyGroup>
  <Target Name="RequirePackage" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DhePackageRoot)' == ''" Text="Pass the package source as DhePackageRoot." />
  </Target>
  <ItemGroup>
    <AssemblyAttribute Include="System.Reflection.AssemblyMetadataAttribute">
      <_Parameter1>DhePackageRoot</_Parameter1>
      <_Parameter2>$(DhePackageRoot)</_Parameter2>
    </AssemblyAttribute>
    <Compile Remove="Unity/**/*.cs" />
    <Compile Remove="Workloads/**/*.cs" />
    <Compile Include="$(DhePackageRoot)/Editor/Commands/DheAotAnalysisSnapshot.cs" Link="Package/DheAotAnalysisSnapshot.cs" />
    <Compile Include="$(DhePackageRoot)/Editor/Commands/DheOrdinaryGuardInventory.cs" Link="Package/DheOrdinaryGuardInventory.cs" />
    <Compile Include="../../AotAnalysisSnapshot.cs" Link="Tool/AotAnalysisSnapshot.cs" />
    <Compile Include="../../MetaVersion.cs" Link="Tool/MetaVersion.cs" />
    <Compile Include="../../ResourceUpdateCompatibility.cs" Link="Tool/ResourceUpdateCompatibility.cs" />
    <Compile Include="../../ResourceExecutionPlan.cs" Link="Tool/ResourceExecutionPlan.cs" />
    <Compile Include="../../DheValueLayoutImpact.cs" Link="Tool/DheValueLayoutImpact.cs" />
    <Compile Include="../../FrozenAotAdaptation.cs" Link="Tool/FrozenAotAdaptation.cs" />
    <Compile Include="../../FrozenAotSourcePlan.cs" Link="Tool/FrozenAotSourcePlan.cs" />
    <Compile Include="../../FrozenAotAdmission.cs" Link="Tool/FrozenAotAdmission.cs" />
    <Reference Include="dnlib"><HintPath>../../dnlib.dll</HintPath></Reference>
  </ItemGroup>
</Project>
