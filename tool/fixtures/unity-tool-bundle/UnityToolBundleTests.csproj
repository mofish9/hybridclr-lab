<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>disable</Nullable>
    <NoWarn>$(NoWarn);0649</NoWarn>
  </PropertyGroup>
  <Target Name="RequirePackage" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(DhePackageRoot)' == ''" Text="Pass DhePackageRoot." />
  </Target>
  <ItemGroup>
    <Compile Include="$(DhePackageRoot)/Editor/Commands/DheToolCommand.cs" Link="DheToolCommand.cs" />
  </ItemGroup>
</Project>
