<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net6.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <AssemblyName>HybridCLR.DheTool</AssemblyName>
    <RootNamespace>HybridCLR.DheTool</RootNamespace>
  </PropertyGroup>
  <Target Name="RequirePackageToolSource" BeforeTargets="PrepareForBuild">
    <Error Condition="!Exists('$(DheToolSourceRoot)/HybridCLR.DheTool.csproj')" Text="Pass DhePackageRoot for the package-owned DHE tool source." />
  </Target>
  <ItemGroup>
    <Compile Include="$(DheToolSourceRoot)/*.cs" />
    <Reference Include="dnlib"><HintPath>$(DheToolSourceRoot)/../../Tools~/DHE/dnlib.dll</HintPath><Private>true</Private></Reference>
    <None Include="$(DheToolSourceRoot)/templates/DheWorkflowBuild.cs" Link="templates/DheWorkflowBuild.cs" CopyToOutputDirectory="PreserveNewest" />
    <None Include="$(DheToolSourceRoot)/templates/DheBuildIdentity.cs" Link="templates/DheBuildIdentity.cs" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
