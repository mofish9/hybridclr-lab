{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-package-lock.schema.json",
  "title": "HybridCLR DHE Embedded Package Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "repository", "baseCommit", "pathBase", "packagePath", "treeSha256", "patches"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-package-lock.json" },
    "repository": { "const": "hybridclr_unity" },
    "sourceMode": { "enum": ["overlay", "integrated"] },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "integratedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "pathBase": { "const": "project-root-v1" },
    "packagePath": { "const": "Packages/com.code-philosophy.hybridclr" },
    "treeSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "patches": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  },
  "allOf": [
    {
      "if": {
        "required": ["sourceMode"],
        "properties": { "sourceMode": { "const": "integrated" } }
      },
      "then": { "required": ["integratedCommit"] }
    }
  ]
}
