{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-package-lock.schema.json",
  "title": "HybridCLR DHE Embedded Package Lock",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "repository", "baseCommit", "packagePath", "treeSha256", "patches"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-package-lock.json" },
    "repository": { "const": "hybridclr_unity" },
    "baseCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "packagePath": { "type": "string", "minLength": 1 },
    "treeSha256": { "type": "string", "pattern": "^[0-9A-Fa-f]{64}$" },
    "patches": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
