{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-resource-update.schema.json",
  "title": "HybridCLR DHE Single-payload Resource Update",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "format", "payloadModel", "metaVersionSchema", "compatibilityPolicy", "runtimeProtocol", "compatibilityValidated", "validation", "validationSha256", "currentAssemblySetSha256", "playerUpdateRequired", "guardCoverageValidated", "runtimeComparison", "runtimePlan", "runtimePlanSha256", "runtimeAssetRoot", "baseMetaVersionAssetRoot", "aotMetadata", "assemblies", "supportedBases"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-resource-update.json" },
    "payloadModel": { "const": "single-current-payload" },
    "metaVersionSchema": { "const": 1 },
    "compatibilityPolicy": { "const": "dhe-proven-safe-subset-v1" },
    "runtimeProtocol": { "const": "dhe-runtime-protocol-v1" },
    "compatibilityValidated": { "const": true },
    "validation": { "const": "dhe-resource-update-validation.json" },
    "validationSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "currentAssemblySetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "playerUpdateRequired": { "const": false },
    "guardCoverageValidated": { "const": true },
    "runtimeComparison": { "const": "embedded-base-mv-vs-current-mv" },
    "runtimePlan": { "const": "dhe-runtime-plan.json" },
    "runtimePlanSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "runtimeAssetRoot": { "type": "string", "minLength": 1 },
    "baseMetaVersionAssetRoot": { "type": "string", "minLength": 1 },
    "aotMetadata": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assemblyName", "sourceKind", "sha256", "manifestSha256", "path"],
        "properties": {
          "assemblyName": { "type": "string", "minLength": 1 },
          "sourceKind": { "const": "resource-update" },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "manifestSha256": { "const": "" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assemblies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assemblyName", "dll", "currentMetaVersion", "dllSha256", "currentMetaVersionSha256"],
        "properties": {
          "assemblyName": { "type": "string", "minLength": 1 },
          "dll": { "type": "string", "minLength": 1 },
          "currentMetaVersion": { "type": "string", "minLength": 1 },
          "dllSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "currentMetaVersionSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "supportedBases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["baseId", "target", "managedAssemblySetSha256", "aotSnapshotSha256", "baseMetaVersionSetSha256", "nativeGuardSourceSha256", "nativeManifestSha256", "runtimeProtocol", "nativeRuntimeContract", "runtimeCapabilities", "requiredRuntimeCapabilities", "runtimeAssetRoot", "baseMetaVersionAssetRoot", "buildIdentitySha256", "compatibilityPolicy", "compatible", "guardCoverageValidated", "unsupportedChangeCount", "unsupportedChanges", "assemblies"],
        "properties": {
          "baseId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "target": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "managedAssemblySetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "aotSnapshotSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "baseMetaVersionSetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "nativeGuardSourceSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "nativeManifestSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "runtimeProtocol": { "const": "dhe-runtime-protocol-v1" },
          "nativeRuntimeContract": { "type": "string", "minLength": 1 },
          "runtimeCapabilities": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "requiredRuntimeCapabilities": {
            "type": "array", "minItems": 2, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "runtimeAssetRoot": { "type": "string", "minLength": 1 },
          "baseMetaVersionAssetRoot": { "type": "string", "minLength": 1 },
          "buildIdentitySha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "compatibilityPolicy": { "const": "dhe-proven-safe-subset-v1" },
          "compatible": { "const": true },
          "guardCoverageValidated": { "const": true },
          "unsupportedChangeCount": { "const": 0 },
          "unsupportedChanges": { "type": "array", "maxItems": 0 },
          "assemblies": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "required": ["assemblyName", "baselineAssemblySha256", "baseMetaVersionSha256", "compatible", "compatibilityPolicy", "unchangedMethodCount", "changedMethodCount", "bodyOnlyChangedMethodCount", "dependencyChangedMethodCount", "removedMethodCount", "addedMethodCount", "removedFieldCount", "addedFieldCount", "changedExistingTypeCount", "removedTypeCount", "addedTypeCount", "guardRequiredMethodCount", "guardCoveredMethodCount", "uncoveredStableMethodIds", "unsupportedChangeCount", "unsupportedChanges"],
              "properties": {
                "assemblyName": { "type": "string", "minLength": 1 },
                "baselineAssemblySha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
                "baseMetaVersionSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
                "compatible": { "const": true },
                "compatibilityPolicy": { "const": "dhe-proven-safe-subset-v1" },
                "unchangedMethodCount": { "type": "integer", "minimum": 0 },
                "changedMethodCount": { "type": "integer", "minimum": 0 },
                "bodyOnlyChangedMethodCount": { "type": "integer", "minimum": 0 },
                "dependencyChangedMethodCount": { "type": "integer", "minimum": 0 },
                "removedMethodCount": { "type": "integer", "minimum": 0 },
                "addedMethodCount": { "type": "integer", "minimum": 0 },
                "removedFieldCount": { "type": "integer", "minimum": 0 },
                "addedFieldCount": { "type": "integer", "minimum": 0 },
                "changedExistingTypeCount": { "type": "integer", "minimum": 0 },
                "removedTypeCount": { "type": "integer", "minimum": 0 },
                "addedTypeCount": { "type": "integer", "minimum": 0 },
                "guardRequiredMethodCount": { "type": "integer", "minimum": 0 },
                "guardCoveredMethodCount": { "type": "integer", "minimum": 0 },
                "uncoveredStableMethodIds": {
                  "type": "array",
                  "maxItems": 0,
                  "items": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
                },
                "unsupportedChangeCount": { "const": 0 },
                "unsupportedChanges": { "type": "array", "maxItems": 0 }
              }
            }
          }
        }
      }
    }
  }
}
