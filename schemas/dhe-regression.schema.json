{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-regression.schema.json",
  "title": "HybridCLR DHE CSharp Regression Report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "generatedAtUtc", "sourceHead", "sourceTree", "sourceClean", "passed", "realWorkflowOutputsValidated", "workflowOutputs", "checks", "errors", "warnings"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-regression.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "sourceHead": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "sourceTree": { "type": "string", "pattern": "^[0-9a-fA-F]{40,64}$" },
    "sourceClean": { "type": "boolean" },
    "passed": { "type": "boolean" },
    "realWorkflowOutputsValidated": { "type": "boolean" },
    "workflowOutputs": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["role", "path", "sha256"],
        "properties": {
          "role": { "enum": ["demo-changed", "demo-changed-base2", "demo-noop"] },
          "path": { "type": "string", "minLength": 1 },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "checks": {
      "type": "array",
      "minItems": 27,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "passed", "details"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "details": { "type": "string" }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "allOf": [
    {
      "if": { "properties": { "realWorkflowOutputsValidated": { "const": true } }, "required": ["realWorkflowOutputsValidated"] },
      "then": { "properties": { "workflowOutputs": { "minItems": 3, "maxItems": 3 } } },
      "else": { "properties": { "workflowOutputs": { "maxItems": 0 } } }
    }
  ]
}
