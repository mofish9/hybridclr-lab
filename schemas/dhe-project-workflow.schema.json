{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-project-workflow.schema.json",
  "title": "HybridCLR DHE Project Workflow Report",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "format", "passed", "mode", "target", "adapterScript", "projectPath", "sourcePreflight", "cleanCheckout", "projectPreflight", "workflowReport", "archiveGate", "releaseGate", "stages"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-project-workflow.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "type": "boolean" },
    "mode": { "enum": ["Release", "Exploratory", "Preflight"] },
    "target": { "const": "StandaloneWindows64" },
    "adapterScript": { "type": "string", "minLength": 1 },
    "projectPath": { "type": "string", "minLength": 1 },
    "sourcePreflight": { "type": ["string", "null"] },
    "cleanCheckout": { "type": ["string", "null"] },
    "projectPreflight": { "type": ["string", "null"] },
    "workflowReport": { "type": ["string", "null"] },
    "archiveGate": { "type": ["string", "null"] },
    "releaseGate": { "type": ["string", "null"] },
    "stages": {
      "type": "object",
      "required": ["prepare", "cleanCheckout", "sourcePreflight", "projectPreflight", "player", "archive", "release"],
      "properties": {
        "prepare": { "$ref": "#/$defs/stage" },
        "cleanCheckout": { "$ref": "#/$defs/stage" },
        "sourcePreflight": { "$ref": "#/$defs/stage" },
        "projectPreflight": { "$ref": "#/$defs/stage" },
        "player": { "$ref": "#/$defs/stage" },
        "archive": { "$ref": "#/$defs/stage" },
        "release": { "$ref": "#/$defs/stage" }
      }
    },
    "errors": { "type": "array", "items": { "type": "string" } },
    "warnings": { "type": "array", "items": { "type": "string" } }
  },
  "$defs": {
    "stage": {
      "type": "object",
      "required": ["passed", "report"],
      "properties": {
        "passed": { "type": "boolean" },
        "report": { "type": ["string", "null"] }
      }
    }
  }
}
