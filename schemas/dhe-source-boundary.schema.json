{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-source-boundary.schema.json",
  "title": "HybridCLR DHE Source Boundary Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "exactPaths", "prefixes", "generatedPrefixes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-source-boundary.json" },
    "exactPaths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "prefixes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "generatedPrefixes": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } }
  }
}
