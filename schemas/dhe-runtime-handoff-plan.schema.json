{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-runtime-handoff-plan.schema.json",
  "title": "HybridCLR DHE Runtime Handoff Plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "format", "assemblies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-runtime-handoff-plan.json" },
    "aotMetadataManifestSha256": { "type": "string", "pattern": "^$|^[0-9a-fA-F]{64}$" },
    "aotMetadata": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["assemblyName", "sourceKind", "sha256", "manifestSha256", "path"],
        "properties": {
          "assemblyName": { "type": "string", "minLength": 1 },
          "sourceKind": { "enum": ["current-stripped", "fallback-root"] },
          "sha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "manifestSha256": { "type": "string", "pattern": "^$|^[0-9a-fA-F]{64}$" },
          "path": { "type": "string", "minLength": 1 }
        }
      }
    },
    "assemblies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assemblyName", "current", "baseline", "mv", "snapshot", "baselineSha256", "currentSha256", "mvSha256", "snapshotSha256"],
        "properties": {
          "assemblyName": { "type": "string", "minLength": 1 },
          "current": { "type": "string", "minLength": 1 },
          "baseline": { "type": "string", "minLength": 1 },
          "mv": { "type": "string", "minLength": 1 },
          "snapshot": { "type": "string", "minLength": 1 },
          "baselineSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "currentSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "mvSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "snapshotSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    }
  }
}
