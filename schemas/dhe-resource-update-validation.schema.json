{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-resource-update-validation.schema.json",
  "title": "HybridCLR DHE Resource Update Compatibility Validation",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "format", "generatedAtUtc", "passed", "compatibilityPolicy", "runtimeProtocol", "currentAssemblySetSha256", "candidateBaseCount", "compatibleBaseCount", "bases", "errors"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-resource-update-validation.json" },
    "generatedAtUtc": { "type": "string", "format": "date-time" },
    "passed": { "type": "boolean" },
    "compatibilityPolicy": { "const": "dhe-proven-safe-subset-v1" },
    "runtimeProtocol": { "const": "dhe-runtime-protocol-v1" },
    "currentAssemblySetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "payloadVariantSetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
    "payloadVariants": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object",
        "required": ["variantId", "currentAssemblySetSha256"],
        "properties": {
          "variantId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
          "currentAssemblySetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" }
        }
      }
    },
    "baseRegistrySha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "baseRegistryEntryCount": { "type": ["integer", "null"], "minimum": 1 },
    "baseRegistryAuditPath": { "type": ["string", "null"], "enum": ["audit/dhe-base-registry.json", null] },
    "baseRegistryAuditSha256": { "type": ["string", "null"], "pattern": "^[0-9a-fA-F]{64}$" },
    "candidateBaseCount": { "type": "integer", "minimum": 1 },
    "compatibleBaseCount": { "type": "integer", "minimum": 0 },
    "bases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["baseId", "target", "managedAssemblySetSha256", "aotSnapshotSha256", "baseMetaVersionSetSha256", "aotMetadataSetId", "nativeGuardSourceSha256", "nativeManifestSha256", "runtimeProtocol", "nativeRuntimeContract", "runtimeCapabilities", "requiredRuntimeCapabilities", "runtimeAssetRoot", "baseMetaVersionAssetRoot", "buildIdentitySha256", "compatibilityPolicy", "compatible", "guardCoverageValidated", "unsupportedChangeCount", "unsupportedChanges", "assemblies"],
        "properties": {
          "baseId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "target": { "type": "string", "pattern": "^[A-Za-z0-9._-]+$" },
          "payloadVariantId": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
          "currentAssemblySetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "assemblyModes": {
            "type": "array",
            "items": {
              "type": "object",
              "required": ["assemblyName", "executionMode"],
              "properties": {
                "assemblyName": { "type": "string", "minLength": 1 },
                "executionMode": { "enum": ["dhe-differential", "interpreter-only"] }
              }
            }
          },
          "managedAssemblySetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "aotSnapshotSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "baseMetaVersionSetSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "aotMetadataSetId": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "nativeGuardSourceSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "nativeManifestSha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "buildIdentitySha256": { "type": "string", "pattern": "^[0-9a-fA-F]{64}$" },
          "runtimeProtocol": { "const": "dhe-runtime-protocol-v1" },
          "nativeRuntimeContract": { "type": "string", "minLength": 1 },
          "runtimeCapabilities": {
            "type": "array",
            "minItems": 2,
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "requiredRuntimeCapabilities": {
            "type": "array", "minItems": 2, "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "runtimeAssetRoot": { "type": "string", "minLength": 1 },
          "baseMetaVersionAssetRoot": { "type": "string", "minLength": 1 },
          "compatibilityPolicy": { "const": "dhe-proven-safe-subset-v1" },
          "compatible": { "type": "boolean" },
          "guardCoverageValidated": { "type": "boolean" },
          "unsupportedChangeCount": { "type": "integer", "minimum": 0 },
          "unsupportedChanges": { "type": "array", "items": { "type": "string", "minLength": 1 } },
          "assemblies": { "type": "array", "minItems": 1 }
        }
      }
    },
    "errors": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
