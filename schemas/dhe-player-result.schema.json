    "structuralExpected": { "type": "boolean" },
    "structuralDispatchExpected": { "type": "boolean" },
    "structuralPassed": { "type": "boolean" },
    "structuralError": { "type": ["string", "null"] },
    "structuralExistingEntryResult": { "type": "integer" },
    "structuralAddedReferenceTypeFound": { "type": "boolean" },
    "structuralAddedGenericTypeFound": { "type": "boolean" },
    "structuralAddedNestedTypeFound": { "type": "boolean" },
    "structuralNestedDeclaringTypeValidated": { "type": "boolean" },
    "structuralAddedStaticMethodFound": { "type": "boolean" },
    "structuralAddedInstanceMethodFound": { "type": "boolean" },
    "structuralAddedStaticFieldsFound": { "type": "boolean" },
    "structuralAddedStaticFieldDeclaringTypeValidated": { "type": "boolean" },
    "structuralAddedStaticFieldReflectionValueValidated": { "type": "boolean" },
    "structuralAddedInstanceFieldsFound": { "type": "boolean" },
    "structuralAddedInstanceFieldDeclaringTypeValidated": { "type": "boolean" },
    "structuralAddedInstanceFieldDefaultValueValidated": { "type": "boolean" },
    "structuralAddedInstanceFieldReflectionValueValidated": { "type": "boolean" },
    "structuralAddedInstanceFieldGcValidated": { "type": "boolean" },
    "structuralRemovedMethodHidden": { "type": "boolean" },
    "structuralRemovedMethodGuardValidated": { "type": "boolean" },
    "structuralRemovedFieldsHidden": { "type": "boolean" },
    "structuralRemovedFieldGuardValidated": { "type": "boolean" },
    "structuralFieldSignatureReplacementVisible": { "type": "boolean" },
    "structuralFieldSignatureReplacementRoundTripValidated": { "type": "boolean" },
