{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/mofish9/hybridclr-lab/schemas/dhe-runtime-plan.schema.json",
  "title": "HybridCLR DHE Runtime Asset Plan",
  "type": "object",
  "additionalProperties": true,
  "required": ["schemaVersion", "format", "assemblies"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "format": { "const": "hybridclr.dhe-runtime-asset-plan.json" },
    "assemblies": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["assemblyName", "current", "mv", "snapshot"],
        "properties": {
          "assemblyName": { "type": "string", "minLength": 1 },
          "current": { "type": "string", "minLength": 1 },
          "mv": { "type": "string", "minLength": 1 },
          "snapshot": { "type": "string", "minLength": 1 }
        }
      }
    }
  }
}
